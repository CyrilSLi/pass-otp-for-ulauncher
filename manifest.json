{
  "required_api_version": "^2.0.0",
  "name": "Pass OTP for Ulauncher",
  "description": "A Ulauncher extension for pass-otp.",
  "developer_name": "Alexander Carter",
  "icon": "images/file-qr.svg",
  "options": {
    "query_debounce": 0.1
  },
  "preferences": [
    {
      "id": "keyword-otp",
      "type": "keyword",
      "name": "otp",
      "description": "Copy one-time-passwords to the clipboard.",
      "default_value": "otp"
    },
    {
      "id": "show_regex",
      "type": "input",
      "name": "Exclude files",
      "description": "Only show password files matching this regular expression",
      "default_value": ".*"
    },
    {
      "id": "show_notification",
      "type": "select",
      "name": "Notificaitons",
      "description": "Whether or not to show a notification when a password has been copied",
      "default_value": "yes",
      "options": [
        "yes",
        "no"
      ]
    }
  ]
}
